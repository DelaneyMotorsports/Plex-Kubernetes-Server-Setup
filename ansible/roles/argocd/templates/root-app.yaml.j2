# Rendered by Ansible from inventory/group_vars/all.yml. This is the single App-of-Apps
# entrypoint: it watches argocd/apps/ in the repo, so every child Application (and the
# AppProject) is deployed and kept in sync automatically. Adding a new app later = commit
# a manifest into argocd/apps/ — no Ansible re-run needed.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: root
  namespace: argocd
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: "{{ gitops_repo_url }}"
    targetRevision: "{{ gitops_repo_revision }}"
    path: argocd/apps
    directory:
      recurse: true
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
    retry:
      limit: 5
      backoff:
        duration: 5s
        factor: 2
        maxDuration: 3m
