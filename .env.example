# ============================================================
# Media Stack — Secret & Config Template
# Copy to .env, fill in your values, then seal the secrets into Git:
#   ./scripts/seal-secrets.sh .env      (GitOps path — encrypted, committed)
# Or, for a non-GitOps direct apply:
#   ./scripts/create-secrets.sh .env
# NEVER commit the .env file (it is in .gitignore)
# ============================================================

# ---- Timezone & User IDs ----
TZ=America/New_York           # Your timezone: timedatectl list-timezones
PUID=1000                     # Your UID: run `id -u`
PGID=1000                     # Your GID: run `id -g`

# ---- VPN — NordVPN WireGuard (Gluetun) ----
VPN_SERVICE_PROVIDER=nordvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=CHANGE-ME        # From: nordvpn meshnet or NordVPN app → Generate key
WIREGUARD_ADDRESSES=CHANGE-ME/32       # e.g. 10.5.0.2/32 (from NordVPN WireGuard config)
SERVER_REGIONS=Europe                  # https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
SERVER_CATEGORIES=P2P                  # "P2P" for torrent-optimized servers
UPDATER_PERIOD=24h
UPDATER_VPN_SERVICE_PROVIDERS=nordvpn

# ---- Plex ----
# Get a 4-minute claim token at: https://plex.tv/claim
# Apply within 4 minutes of first pod start. Remove after initial claim.
PLEX_CLAIM=CHANGE-ME

# ---- qBittorrent ----
WEBUI_PORT=8080

# ---- NAS / storage (the separate "Nomad" box that serves media over NFS) ----
# The Kubernetes NFS PV is set in k8s/overlays/pi5/nas-patch.yaml (committed to Git so
# Argo can use it). These vars let the installer/Ansible pass the same values through
# and run a reachability check. Keep them in sync with nas-patch.yaml.
# On the NAS, export a single directory holding media/ and downloads/, owned by
# PUID:PGID above (e.g. exported with no_root_squash, or all_squash + anonuid/anongid).
NAS_IP=192.168.1.50
NAS_EXPORT_PATH=/export/media
